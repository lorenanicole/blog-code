# Copy to .env and fill in. The .env is gitignored; this example is not.
# Anything exported in your shell overrides what's here.

# --- the model being audited (the generator) ---
ANTHROPIC_API_KEY=

# --- the grader ---
# jevals picks a backend from the environment, first match wins:
#   JEVALS_BACKEND > TYPESAFE_API_KEY > AI_GATEWAY_API_KEY > KEV_BASE_URL
#   > OPENROUTER_API_KEY > OPENAI_API_KEY
# Anthropic is NOT a jevals backend, so ANTHROPIC_API_KEY alone cannot grade a run.
# Set exactly one of these.

# Jev via Vercel AI Gateway (what the README assumes)
AI_GATEWAY_API_KEY=

# Jev direct
# TYPESAFE_API_KEY=

# Local Kev server, no cloud key
# KEV_BASE_URL=localhost:8009

# Generic LLM-as-grader fallback. Works, but it is NOT Jev: it changes what the
# audit measures, so say so in anything you publish and calibrate before trusting it.
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# --- optional ---
# Audit a non-Anthropic model through OpenRouter (--provider openrouter)
# OPENROUTER_API_KEY=
